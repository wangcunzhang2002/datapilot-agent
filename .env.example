# Qwen via Alibaba Cloud Model Studio OpenAI-compatible API.
AGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENT_LLM_API_KEY=replace-with-your-dashscope-key
AGENT_LLM_MODEL=qwen-plus
AGENT_LLM_TIMEOUT_SECONDS=20
AGENT_IP_WINDOW_SECONDS=60
AGENT_IP_MAX_REQUESTS=20
AGENT_GLOBAL_WINDOW_SECONDS=1
AGENT_GLOBAL_QPS=5
AGENT_SESSION_MAX_ROUNDS=12
AGENT_DAILY_CALL_LIMIT=100
AGENT_MAX_INPUT_CHARS=500
AGENT_LLM_MAX_TOKENS=400
TRUST_PROXY_HEADERS=false
AGENT_RUNTIME_DIR=/app/runtime
